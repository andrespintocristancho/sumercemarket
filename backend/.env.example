# Puerto del servidor
PORT=4000

# Secreto JWT (cámbialo en producción por algo largo y aleatorio)
JWT_SECRET=cambia-este-secreto-en-produccion-por-uno-largo-y-aleatorio

# Tiempo de expiración del token
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Credenciales del admin por defecto (se crea al inicio si no existe)
ADMIN_EMAIL=admin@sumercemarket.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador
